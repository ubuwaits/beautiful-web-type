{
  "name": "beautiful-web-type",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "audit:security": "osv-scanner scan source --lockfile=pnpm-lock.yaml --verbosity=error",
    "audit:typefaces": "tsx scripts/audit-typefaces.ts",
    "prepare:static": "tsx scripts/prepare-static.ts",
    "predev": "pnpm prepare:static",
    "dev": "next dev",
    "prebuild": "pnpm prepare:static",
    "build": "next build",
    "postbuild": "tsx scripts/verify-export.ts",
    "deploy": "pnpm build && wrangler deploy --profile personal",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "start": "serve out -l 3000",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && env -u NO_COLOR playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "js-yaml": "^4.3.0",
    "next": "^16.2.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.51.1",
    "postcss": "^8.5.18",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "wrangler": "^4.134.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "brace-expansion": "^1.1.16",
      "fast-uri": "~3.1.5",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "vite": "^7.3.5",
      "esbuild": "~0.28.1"
    }
  }
}
